{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Packet v4.0",
  "description": "Structural schema for the Relay-generated audit packet.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {},
    "run": { "$ref": "#/$defs/run" },
    "repository": { "$ref": "#/$defs/repository" },
    "authority": { "$ref": "#/$defs/authority" },
    "deterministic_application": { "$ref": "#/$defs/deterministic_application" },
    "execution": { "$ref": "#/$defs/execution" },
    "changed_files": { "type": "array", "items": { "$ref": "#/$defs/changed_file" } },
    "relevant_source_paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "validation": { "type": "array", "items": { "$ref": "#/$defs/validation_result" } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
  },
  "required": ["run", "repository", "authority", "deterministic_application", "execution", "changed_files", "relevant_source_paths", "validation", "artifacts"],
  "allOf": [
    { "if": { "properties": { "deterministic_application": { "properties": { "outcome": { "const": "not_present" } }, "required": ["outcome"] } }, "required": ["deterministic_application"] }, "then": { "properties": { "authority": { "not": { "required": ["deterministic_operations"] } }, "execution": { "properties": { "adaptive_attempt_dispatched": { "const": true } }, "required": ["adaptive_attempt_dispatched"] } } } },
    { "if": { "properties": { "deterministic_application": { "properties": { "outcome": { "enum": ["preflight_failed", "applied"] } }, "required": ["outcome"] } }, "required": ["deterministic_application"] }, "then": { "properties": { "authority": { "required": ["deterministic_operations"] } } } },
    { "if": { "properties": { "deterministic_application": { "properties": { "outcome": { "const": "preflight_failed" } }, "required": ["outcome"] } }, "required": ["deterministic_application"] }, "then": { "properties": { "execution": { "properties": { "adaptive_attempt_dispatched": { "const": true } }, "required": ["adaptive_attempt_dispatched"] } } } },
    { "if": { "properties": { "deterministic_application": { "properties": { "outcome": { "const": "applied" }, "coverage": { "const": "partial" } }, "required": ["outcome", "coverage"] } }, "required": ["deterministic_application"] }, "then": { "properties": { "execution": { "properties": { "adaptive_attempt_dispatched": { "const": true } }, "required": ["adaptive_attempt_dispatched"] } } } },
    { "if": { "properties": { "deterministic_application": { "properties": { "outcome": { "const": "applied" }, "coverage": { "const": "complete" } }, "required": ["outcome", "coverage"] } }, "required": ["deterministic_application"] }, "then": { "properties": { "execution": { "properties": { "adaptive_attempt_dispatched": { "const": false } }, "required": ["adaptive_attempt_dispatched"] } } } }
  ],
  "$defs": {
    "machine_string": { "type": "string", "pattern": "^(?!.*[\\r\\n])(?!\\s*$)(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$" },
    "multiline_prose": { "type": "string", "pattern": "^[\\s\\S]*\\S[\\s\\S]*$" },
    "path": { "type": "string", "pattern": "^(?!.*[\\r\\n])(?!/)(?![A-Za-z]:)(?!//)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?$)(?!.*(?:^|/)\\.\\.?/)(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001F\\u007F]).*\\S.*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run": { "type": "object", "additionalProperties": false, "properties": { "run_id": { "type": "integer", "minimum": 1 }, "user_intent": { "$ref": "#/$defs/multiline_prose" } }, "required": ["run_id", "user_intent"] },
    "repository": { "type": "object", "additionalProperties": false, "properties": { "repo_target": { "$ref": "#/$defs/machine_string" }, "branch": { "$ref": "#/$defs/machine_string" }, "base_commit": { "$ref": "#/$defs/commit_sha" }, "audited_commit": { "$ref": "#/$defs/commit_sha" } }, "required": ["repo_target", "branch", "base_commit", "audited_commit"] },
    "artifact": { "type": "object", "additionalProperties": false, "properties": { "filename": { "$ref": "#/$defs/machine_string" }, "sha256": { "$ref": "#/$defs/sha256" }, "content": {} }, "required": ["filename", "sha256", "content"] },
    "authority": { "type": "object", "additionalProperties": false, "properties": { "delivery_ticket": { "$ref": "#/$defs/artifact" }, "requirements": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "shared_design": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "deterministic_operations": { "$ref": "#/$defs/embedded_deterministic_operations" }, "execution_assignment": { "$ref": "#/$defs/runtime_artifact" } }, "required": ["delivery_ticket", "requirements", "shared_design", "execution_assignment"] },
    "embedded_deterministic_operations": { "type": "object", "additionalProperties": false, "properties": { "filename": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.ticket-[^.]+\\.r[1-9][0-9]*\\.deterministic-operations\\.json$" }, "sha256": { "$ref": "#/$defs/sha256" }, "content": { "$ref": "deterministic-operations.schema.json" } }, "required": ["filename", "sha256", "content"] },
    "runtime_artifact": { "type": "object", "additionalProperties": false, "properties": { "artifact_reference": { "$ref": "#/$defs/machine_string" }, "sha256": { "$ref": "#/$defs/sha256" } }, "required": ["artifact_reference", "sha256"] },
    "deterministic_application": { "type": "object", "additionalProperties": false, "properties": { "outcome": { "enum": ["not_present", "preflight_failed", "applied"] }, "coverage": { "enum": ["complete", "partial"] }, "evidence": { "$ref": "#/$defs/runtime_artifact" } }, "required": ["outcome", "evidence"], "allOf": [{ "if": { "properties": { "outcome": { "const": "not_present" } }, "required": ["outcome"] }, "then": { "not": { "required": ["coverage"] } }, "else": { "required": ["coverage"] } }] },
    "execution": { "type": "object", "additionalProperties": false, "properties": { "adaptive_attempt_dispatched": { "type": "boolean" }, "status": { "$ref": "#/$defs/machine_string" }, "committed_sha": { "$ref": "#/$defs/commit_sha" }, "completion_summary": { "$ref": "#/$defs/multiline_prose" } }, "required": ["adaptive_attempt_dispatched", "status", "committed_sha", "completion_summary"] },
    "changed_file": { "type": "object", "additionalProperties": false, "properties": { "path": { "$ref": "#/$defs/path" }, "previous_path": { "$ref": "#/$defs/path" }, "change_type": { "enum": ["added", "modified", "deleted", "renamed", "copied", "type_changed"] }, "additions": { "type": "integer", "minimum": 0 }, "deletions": { "type": "integer", "minimum": 0 } }, "required": ["path", "change_type", "additions", "deletions"] },
    "validation_result": { "type": "object", "additionalProperties": false, "properties": { "command": { "$ref": "#/$defs/machine_string" }, "expected": { "$ref": "#/$defs/machine_string" }, "status": { "enum": ["passed", "failed", "not_run"] }, "concise_result": { "$ref": "#/$defs/multiline_prose" } }, "required": ["command", "expected", "status", "concise_result"] }
  }
}
