{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Plan v1.0",
  "description": "Structural schema for the canonical Delivery Plan artifact.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {},
    "feature_slug": { "$ref": "#/$defs/feature_slug" },
    "goal": { "$ref": "#/$defs/single_line_prose" },
    "context": { "$ref": "#/$defs/multiline_prose" },
    "scope": { "$ref": "#/$defs/scope" },
    "units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unit" } }
  },
  "required": [ "feature_slug", "goal", "context", "scope", "units" ],
  "$defs": {
    "feature_slug": { "type": "string", "pattern": "^(?!.*[\\r\\n])[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "single_line_prose": { "type": "string", "pattern": "^(?!.*[\\r\\n])(?!\\s*$)[^\\r\\n]*\\S[^\\r\\n]*$" },
    "multiline_prose": { "type": "string", "pattern": "^[\\s\\S]*\\S[\\s\\S]*$" },
    "criteria_array": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/single_line_prose" } },
    "scope": {
      "type": "object", "additionalProperties": false,
      "properties": { "in_scope": { "$ref": "#/$defs/criteria_array" }, "out_of_scope": { "$ref": "#/$defs/criteria_array" } },
      "required": [ "in_scope", "out_of_scope" ]
    },
    "unit_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$" },
    "unit": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "unit_id": { "$ref": "#/$defs/unit_id" },
        "goal": { "$ref": "#/$defs/single_line_prose" },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/unit_id" } }
      },
      "required": [ "unit_id", "goal", "depends_on" ]
    }
  }
}
